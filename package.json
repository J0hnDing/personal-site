{
  "name": "john-personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:gallery": "node scripts/prepare-gallery-assets.mjs",
    "upload:gallery": "node scripts/upload-gallery-originals.mjs",
    "deploy": "npm run build && npm run deploy:built",
    "deploy:built": "npm run upload:gallery && wrangler deploy",
    "version:built": "npm run upload:gallery && wrangler versions upload",
    "predev": "npm run prepare:gallery",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "prebuild": "npm run prepare:gallery",
    "build": "tsc -b && vite build",
    "sample:gallery": "npm run prepare:gallery && vite samples/gallery-tree --host 127.0.0.1 --port 5174",
    "sample:gallery:build": "npm run prepare:gallery && tsc -p samples/gallery-tree/tsconfig.json && vite build samples/gallery-tree --outDir ../../dist-gallery-tree-sample --emptyOutDir",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "lenis": "^1.3.26",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.132.0"
  }
}
